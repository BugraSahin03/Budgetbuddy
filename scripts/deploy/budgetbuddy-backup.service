[Unit]
Description=Create a SQLite-safe BudgetBuddy backup
Documentation=docs/backup-and-restore.md
After=budgetbuddy.service

[Service]
Type=oneshot
User=budgetbuddy
Group=budgetbuddy
WorkingDirectory=/opt/budgetbuddy
Environment=NODE_ENV=production
Environment=BUDGETBUDDY_DB_PATH=/var/lib/budgetbuddy/budgetbuddy.db
Environment=BUDGETBUDDY_BACKUP_DIR=/var/backups/budgetbuddy
Environment=BUDGETBUDDY_BACKUP_RETENTION_DAYS=30
UMask=0077
ExecStart=/usr/bin/node scripts/backup/create-backup.mjs
